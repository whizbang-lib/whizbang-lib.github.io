# ngx-markdown's peerOptional katex is ^0.16.0 and every published version says so, while the site pins
# katex ^0.17.0 for marked-katex-extension. No pair of versions satisfies both, so the install is accepted
# with the peer conflict rather than resolving it. Set here rather than passed on the command line so a
# local install and CI's `npm ci || npm install` behave the same way.
# Revisit when ngx-markdown accepts katex 0.17, or when the site drops one of the two.
legacy-peer-deps=true
